# 이 파일을 .env로 복사해서 키를 채우세요. 둘 중 하나만 있어도 됩니다.

# claude | gemini  (비우면 채워진 키로 자동 선택, 둘 다 있으면 claude)
LLM_PROVIDER=

# 비우면 기본 모델 (claude: claude-opus-5-5, gemini: gemini-3.5-flash-lite)
LLM_MODEL=

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# https://aistudio.google.com/apikey  (무료 등급 가능)
GEMINI_API_KEY=
